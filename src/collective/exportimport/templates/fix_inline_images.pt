<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      i18n:domain="collective.exportimport"
      metal:use-macro="context/main_template/macros/master">

<div metal:fill-slot="main">
    <tal:main-macro metal:define-macro="main">

        <h1 class="documentFirstHeading" tal:content="python: view.title" i18n:translate="">
            Extract inline Slate images into standalone image blocks
        </h1>

        <p i18n:translate="">
            This view searches for content with Volto blocks below the current context
            and extracts inline Slate images into separate image blocks.
        </p>

        <form action="@@fix_inline_images" tal:attributes="action request/URL" method="post">
            <div class="field mb-3">
                <label for="portal_types" i18n:translate="">Portal types</label>
                <input class="form-control" type="text" name="portal_types" id="portal_types"
                       value="Document,News Item">
                <small class="form-text text-muted" i18n:translate="">
                    Comma-separated list of portal types to process.
                </small>
            </div>

            <div class="field mb-3 form-check">
                <input class="form-check-input" type="checkbox" name="form.dry_run" id="dry_run" value="1" checked="checked">
                <label class="form-check-label" for="dry_run" i18n:translate="">
                    Dry run (do not modify anything)
                </label>
            </div>

            <div class="field mb-3 form-check">
                <input class="form-check-input" type="checkbox" name="form.commit" id="commit" value="1" checked="checked">
                <label class="form-check-label" for="commit" i18n:translate="">
                    Commit transaction
                </label>
            </div>

            <div class="formControls" class="form-group">
                <button class="btn btn-primary submit-widget button-field context"
                        type="submit" name="form.submitted" value="Run"
                        i18n:attributes="value" i18n:translate="">Run
                </button>
            </div>
        </form>

        <div metal:use-macro="context/@@exportimport_links/links">
          Links to all exports and imports
        </div>

    </tal:main-macro>
</div>

</html>
